# Copy to .env. Never commit .env.
APP_TODAY=2026-10-05
DEV_USER=nick@dev
DUCKDB_PATH=build/attractions.duckdb
# Ask the data replays evals/recordings/ unless ASK_CLIENT=anthropic, which
# calls the API with the key below. `make evals RECORD=1` uses the key to
# write new recordings.
ASK_CLIENT=recorded
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
